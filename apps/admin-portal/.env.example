# LikasLens Admin Portal Environment
# Copy this file to .env.local and fill in your values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only — required for admin CRUD routes (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Gateway (server-side only — never exposed to the browser)
RENDER_AI_URL=
LOCAL_AI_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=120000
AI_HEALTH_CACHE_TTL=30000
# API key for authenticating with the AI service (X-API-Key header)
AI_SERVICE_API_KEY=your_ai_service_api_key_here
