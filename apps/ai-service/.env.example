# AI Service Configuration
AI_SERVICE_PORT=8001

# Google Generative AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Neo4j AuraDB (Graph Database)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# CORS Origins (comma-separated, defaults to localhost ports if empty)
# CORS_ORIGINS=https://likaslens.syntaxure.dev,https://likasadmin.syntaxure.dev

# YOLO Model Path (optional, defaults to yolov8n.pt)
# YOLO_MODEL_PATH=/app/models/custom.pt

# Environment
ENVIRONMENT=development

# Debug mode (set to "true" to include error details in responses)
APP_DEBUG=false
