# ============================================================================
# LikasLens AI Service — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
# All variables are sourced through apps/ai-service/config.py (Pydantic Settings).
#
# Classification:
#   Required in Production — service will fail fast without these
#   Optional               — has a sane default or is a fully optional integration
#   Development Only       — should never be set in production
# ============================================================================

# ── Required in Production ────────────────────────────────────────────────

# SQLAlchemy async database URL (e.g. postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=

# ── Supabase Auth ────────────────────────────────────────────────────────
# Required for ES256 (asymmetric) JWT verification via JWKS.
# This is the primary auth configuration — Supabase signs with ECC P-256.
SUPABASE_URL=https://xxxx.supabase.co

# Optional: Legacy HS256 (shared secret) verification.
# Only needed if you still have tokens signed with the old HS256 key.
# ES256 via JWKS is preferred and does NOT require this secret.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWKS cache TTL in seconds (default: 3600 = 1 hour).
# How long the fetched signing keys are cached before re-fetching.
# JWKS_CACHE_TTL_SECONDS=3600

# ── Optional — Core Service ───────────────────────────────────────────────

# API key for service-to-service auth (X-API-Key header). Empty = dev mode, all requests allowed.
# AI_SERVICE_API_KEY=

# Port the AI service listens on (default: 8001)
# AI_SERVICE_PORT=8001

# Comma-separated list of allowed CORS origins (default includes localhost:3000,3001,3002,8000)
# CORS_ORIGINS=https://likaslens.com,https://staging.likaslens.com,http://localhost:3000

# ── Optional — AI Providers ──────────────────────────────────────────────

# Google Generative AI (Gemini) — required for chat, hazard analysis, graph RAG
# GOOGLE_API_KEY=your_google_api_key_here

# Roboflow hosted inference API (optional, for enhanced detection)
# ROBOFLOW_API_KEY=your_roboflow_api_key_here
# ROBOFLOW_MODEL_ID=garbage-detection-sht1u/4

# ── Optional — Graph Database ────────────────────────────────────────────

# Neo4j AuraDB (graph features disabled when not set)
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here

# ── Optional — Supabase Storage ──────────────────────────────────────────

# S3-compatible storage for evidence uploads (uploads fail when not set)
# SUPABASE_STORAGE_URL=https://xxxx.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_KEY=your_supabase_storage_access_key
# SUPABASE_STORAGE_SECRET=your_supabase_storage_secret_key
# SUPABASE_STORAGE_BUCKET=evidence

# ── Optional — YOLO Models ──────────────────────────────────────────────

# Custom YOLO model paths (default: yolov8n.pt, no env model)
# YOLO_MODEL_PATH=/app/models/custom.pt
# ENV_MODEL_PATH=models/yolov8-waste.pt

# ── Optional — Observability ─────────────────────────────────────────────

# Inference metrics JSONL log path (disabled when not set)
# LIKASLENS_METRICS_LOG=data/inference_metrics.jsonl

# ── Development Only ─────────────────────────────────────────────────────

# Enable verbose error details in API responses (default: false)
# APP_DEBUG=false
