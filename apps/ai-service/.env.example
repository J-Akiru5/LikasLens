# AI Service Configuration
AI_SERVICE_PORT=8001

# Google Generative AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Cosmos DB Gremlin
COSMOS_GREMLIN_ENDPOINT=wss://<account>.gremlin.cosmos.azure.com:443/
COSMOS_GREMLIN_KEY=your_cosmos_gremlin_key_here
COSMOS_GREMLIN_DATABASE=likaslens
COSMOS_GREMLIN_GRAPH=routing_graph
COSMOS_GREMLIN_PARTITION_KEY=likaslens-routing-seed

# Azure Cosmos DB Gremlin (legacy connection string format)
COSMOS_GREMLIN_CONNECTION_STRING=AccountEndpoint=https://your-account.gremlin.cosmos.azure.com:443/;AccountKey=your-key;Database=likaslens;Graph=routing_graph

# YOLOv8 Environmental Model
# Path to a custom-trained YOLOv8 model for environmental hazard detection.
# If not set, falls back to the default COCO model (yolov8n.pt).
# The Dockerfile downloads from HuggingFace at build time using ENV_MODEL_REPO.
# Download community models from: https://huggingface.co/models?search=yolov8+waste
ENV_MODEL_PATH=models/yolov8-waste.pt
ENV_MODEL_REPO=HrutikAdsare/waste-detection-yolov8

# Environment
ENVIRONMENT=production
