# AI Service Configuration
AI_SERVICE_PORT=8001

# Google Generative AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Cosmos DB Gremlin
COSMOS_GREMLIN_ENDPOINT=wss://<account>.gremlin.cosmos.azure.com:443/
COSMOS_GREMLIN_KEY=your_cosmos_gremlin_key_here
COSMOS_GREMLIN_DATABASE=likaslens
COSMOS_GREMLIN_GRAPH=routing_graph
COSMOS_GREMLIN_PARTITION_KEY=likaslens-routing-seed

# CORS Origins (comma-separated, defaults to localhost ports if empty)
# CORS_ORIGINS=https://likaslens.vercel.app,https://admin.likaslens.vercel.app

# YOLO Model Path (optional, defaults to yolov8n.pt)
# YOLO_MODEL_PATH=/app/models/custom.pt

# Environment
ENVIRONMENT=development

# Debug mode (set to "true" to include error details in responses)
APP_DEBUG=false
