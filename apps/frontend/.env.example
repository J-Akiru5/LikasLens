# LikasLens Frontend Environment
# Copy this file to .env.local and fill in your values.

# Laravel Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Admin (server-only — required for account deletion)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Backend URLs (server-only — for SSE proxy and PDF certificate routes)
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_URL=http://127.0.0.1:8000

# Admin Portal URL (for cross-links)
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3002

# Site URL (for SEO canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://likaslens.syntaxure.dev
